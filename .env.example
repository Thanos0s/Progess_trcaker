# ─── Database ───────────────────────────────────────────────────────────────
# Local SQLite (dev only):
# DATABASE_URL="file:./dev.db"
# DIRECT_URL="file:./dev.db"

# Vercel + Neon Postgres (copy both URLs from the Neon dashboard):
# DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require"

DATABASE_URL="file:./dev.db"
DIRECT_URL="file:./dev.db"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Any long random string — signs the session JWT.
# Generate one at: https://generate-secret.vercel.app/64
AUTH_SECRET="change-me-to-a-long-random-string"

# ─── App ─────────────────────────────────────────────────────────────────────
# Used for streak / score day-boundary calculations.
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"
