# SQLite for local dev. Point at Postgres (and flip `provider` in
# prisma/schema.prisma to "postgresql") for a hosted deployment.
DATABASE_URL="file:./dev.db"

# Any long random string — signs the session JWT.
AUTH_SECRET="change-me-to-a-long-random-string"

# Calendar day boundary used for streaks, daily scores and leaderboards.
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"
