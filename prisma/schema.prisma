// Switch `provider` to "postgresql" (and point DATABASE_URL at your Postgres
// instance) to deploy on a hosted database — no other change is required.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  avatar       String   @default("🚀")
  color        String   @default("#6c63ff")
  branch       String   @default("CSE")
  createdAt    DateTime @default(now())

  topicProgress  TopicProgress[]
  dailyTasks     DailyTaskDone[]
  studySessions  StudySession[]
  dailyScores    DailyScore[]
}

model TopicProgress {
  id          String   @id @default(cuid())
  userId      String
  topicId     String
  branch      String
  subjectId   String
  completedAt DateTime @default(now())
  day         String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, day])
}

model DailyTaskDone {
  id     String @id @default(cuid())
  userId String
  day    String
  taskId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, taskId])
  @@index([userId, day])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  day       String
  subjectId String
  minutes   Int
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day])
}

model DailyScore {
  id            String   @id @default(cuid())
  userId        String
  day           String
  score         Int      @default(0)
  topicsDone    Int      @default(0)
  tasksDone     Int      @default(0)
  minutesLogged Int      @default(0)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
}
